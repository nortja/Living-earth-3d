config_version=5

[application]
config/name="Living Earth 3D"
config/version="0.9.0"
config/icon="res://assets/icon.png"
config/windows_native_icon="res://assets/icon.ico"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
run/max_fps=60
run/main_scene="res://scenes/earth.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.004, 0.008, 0.02, 1)

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"
window/stretch/aspect="expand"
window/size/min_width=800
window/size/min_height=600
window/dpi/allow_hidpi=true
